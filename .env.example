# ==============================================================================
# InstaDown — Environment Configuration Template
# Copy this file to .env and configure your production values.
# NEVER commit your real .env file with secrets into version control!
# ==============================================================================

# Application Port (Default: 5000)
PORT=5000

# Flask Secret Key for session integrity (Generate using: python -c 'import secrets; print(secrets.token_hex(32))')
FLASK_SECRET_KEY=replace_with_a_secure_random_hex_key

# Canonical Base URL (without trailing slash)
BASE_URL=https://instagram-story-downloader.onrender.com

# Google Analytics 4 Measurement ID (Optional, leave blank if disabled)
GA_MEASUREMENT_ID=

# Google Search Console Verification Code
GOOGLE_SITE_VERIFICATION=googled6b96ac3b100fcd2
